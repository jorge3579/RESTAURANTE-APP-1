{
  "name": "smartrestaurantqr-restaurante",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist",
    "build:apk": "pnpm dlx eas-cli build --platform android --profile production",
    "android:local": "pnpm exec expo run:android --variant release",
    "build:local": "cd android && ./gradlew assembleRelease",
    "prebuild": "pnpm exec expo prebuild --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-picker/picker": "^2.11.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.9",
    "expo": "~52.0.0",
    "expo-barcode-scanner": "~13.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-image-picker": "~16.0.6",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
