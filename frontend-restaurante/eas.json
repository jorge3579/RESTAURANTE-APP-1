            }
        },
        "production": {
            "environment": "production",
            "node": "20.18.3",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://emphasis-expanse-evolution.ngrok-free.dev/api",
                "EXPO_PUBLIC_SOCKET_URL": "https://emphasis-expanse-evolution.ngrok-free.dev",
                "EXPO_PUBLIC_STOCK_WEB_URL": "https://emphasis-expanse-evolution.ngrok-free.dev/stock/"
