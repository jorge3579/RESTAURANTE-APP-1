        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "lan": {
            "environment": "production",
            "node": "20.18.3",
            "env": {
                "EXPO_PUBLIC_API_URL": "http://192.168.0.7:3000/api",
                "EXPO_PUBLIC_SOCKET_URL": "http://192.168.0.7:3000",
                "EXPO_PUBLIC_STOCK_WEB_URL": "https://emphasis-expanse-evolution.ngrok-free.dev/stock/"
