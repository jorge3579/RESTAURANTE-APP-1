@page "/cambiar-clave"
@attribute [Authorize]
@inject IAuthService Auth
@inject ISnackbar Snackbar
<PageTitle>Cambiar contraseña</PageTitle><div class="page-heading"><div><span class="eyebrow">MI CUENTA</span><MudText Typo="Typo.h4">Cambiar contraseña</MudText><p>Usá una clave única de al menos 10 caracteres.</p></div></div><MudPaper Class="pa-6" Style="max-width:520px"><EditForm Model="model" OnValidSubmit="Save"><MudTextField @bind-Value="model.CurrentPassword" Label="Contraseña actual" InputType="InputType.Password" Required="true" /><MudTextField @bind-Value="model.NewPassword" Label="Nueva contraseña" InputType="InputType.Password" Required="true" Class="mt-4" HelperText="Mínimo 10 caracteres" /><MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-5">Actualizar contraseña</MudButton></EditForm></MudPaper>
@code { [CascadingParameter]private Task<AuthenticationState> AuthenticationStateTask{get;set;}=null!;private ChangePasswordRequest model=new();private async Task Save(){var a=await AuthenticationStateTask;var id=a.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value;var r=await Auth.ChangePasswordAsync(id,model);Snackbar.Add(r.Success?"Contraseña actualizada.":r.Error!,r.Success?Severity.Success:Severity.Error);if(r.Success)model=new();}}
