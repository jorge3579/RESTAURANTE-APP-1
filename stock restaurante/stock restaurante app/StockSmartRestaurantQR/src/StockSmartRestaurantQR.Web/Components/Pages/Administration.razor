@page "/administracion"
@attribute [Authorize(Roles="Admin")]
@inject IAdminService Admin
@inject ISnackbar Snackbar
<PageTitle>Administración</PageTitle><div class="page-heading"><div><span class="eyebrow">CONTROL</span><MudText Typo="Typo.h4">Auditoría y configuración</MudText><p>Parámetros del sistema y registro de actividad administrativa.</p></div></div>
<MudPaper Class="pa-5 mb-5"><MudText Typo="Typo.h6">Configuración</MudText>@foreach(var s in settings){<div class="cart-line"><strong>@s.Key</strong><MudTextField T="string" Value="s.Value" ValueChanged="@((string v)=>Update(s,v))" /><span>@s.Description</span><span></span></div>}</MudPaper>
<MudPaper Class="pa-5"><MudText Typo="Typo.h6">Últimas acciones</MudText><table class="data-table"><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Datos</th></tr></thead><tbody>@foreach(var a in audit){<tr><td>@a.Timestamp.ToLocalTime().ToString("g")</td><td>@a.UserId</td><td>@a.Action</td><td>@a.EntityName #@a.EntityId</td><td class="audit-data">@a.NewValues</td></tr>}</tbody></table></MudPaper>
@code { [CascadingParameter]private Task<AuthenticationState> AuthenticationStateTask{get;set;}=null!;private IReadOnlyList<SettingDto> settings=[];private IReadOnlyList<AuditLogDto> audit=[];protected override async Task OnInitializedAsync(){settings=await Admin.GetSettingsAsync();audit=(await Admin.GetAuditAsync(1,100)).Items;}private async Task Update(SettingDto s,string value){var a=await AuthenticationStateTask;var r=await Admin.SaveSettingAsync(s with{Value=value},a.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);Snackbar.Add(r.Success?"Configuración actualizada.":r.Error!,r.Success?Severity.Success:Severity.Error);settings=await Admin.GetSettingsAsync();}}
