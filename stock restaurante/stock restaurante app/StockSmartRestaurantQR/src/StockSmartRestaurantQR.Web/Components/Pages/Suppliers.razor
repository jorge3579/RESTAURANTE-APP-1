@page "/proveedores"
@attribute [Authorize(Roles="Admin")]
@inject IInventoryService Inventory
@inject ISnackbar Snackbar
<PageTitle>Proveedores</PageTitle><div class="page-heading"><div><span class="eyebrow">ABASTECIMIENTO</span><MudText Typo="Typo.h4">Proveedores</MudText><p>Centralizá los datos comerciales y de contacto.</p></div></div>
<MudPaper Class="pa-5 mb-5"><EditForm Model="model" OnValidSubmit="Save"><MudGrid><MudItem xs="12" md="3"><MudTextField @bind-Value="model.Name" Label="Razón social" Required="true" /></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="model.ContactName" Label="Contacto" /></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="model.Phone" Label="Teléfono" /></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="model.Email" Label="Email" /></MudItem><MudItem xs="12"><MudTextField @bind-Value="model.Address" Label="Dirección" /></MudItem></MudGrid><MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Guardar</MudButton></EditForm></MudPaper>
<MudPaper Class="pa-5"><table class="data-table"><thead><tr><th>Proveedor</th><th>Contacto</th><th>Teléfono</th><th>Email</th></tr></thead><tbody>@foreach(var s in items){<tr><td>@s.Name</td><td>@s.ContactName</td><td>@s.Phone</td><td>@s.Email</td></tr>}</tbody></table></MudPaper>
@code { [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask {get;set;}=null!;private SupplierRequest model=new();private IReadOnlyList<SupplierDto> items=[];protected override async Task OnInitializedAsync()=>items=await Inventory.GetSuppliersAsync();private async Task Save(){var a=await AuthenticationStateTask;var r=await Inventory.SaveSupplierAsync(model,a.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);Snackbar.Add(r.Success?"Proveedor guardado.":r.Error!,r.Success?Severity.Success:Severity.Error);model=new();items=await Inventory.GetSuppliersAsync();}}
