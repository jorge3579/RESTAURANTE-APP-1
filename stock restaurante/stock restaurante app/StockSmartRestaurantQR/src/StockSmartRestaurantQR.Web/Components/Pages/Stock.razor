@page "/stock"
@attribute [Authorize]
@inject IInventoryService Inventory
@inject ISnackbar Snackbar
<PageTitle>Movimientos</PageTitle><div class="page-heading"><div><span class="eyebrow">INVENTARIO</span><MudText Typo="Typo.h4">Movimientos de stock</MudText><p>Registrá entradas, salidas y ajustes con trazabilidad completa.</p></div></div>
<MudPaper Class="pa-5 mb-5"><EditForm Model="model" OnValidSubmit="Save"><MudGrid>
<MudItem xs="12" md="4"><MudSelect T="int" @bind-Value="model.ProductId" Label="Producto">@foreach(var p in products){<MudSelectItem Value="p.Id">@p.Code - @p.Name (@p.Stock)</MudSelectItem>}</MudSelect></MudItem>
<MudItem xs="12" md="2"><MudSelect T="MovementType" @bind-Value="model.MovementType" Label="Tipo"><MudSelectItem Value="MovementType.Entry">Entrada</MudSelectItem><MudSelectItem Value="MovementType.Exit">Salida</MudSelectItem><MudSelectItem Value="MovementType.Adjustment">Ajuste a cantidad</MudSelectItem></MudSelect></MudItem>
<MudItem xs="12" md="2"><MudNumericField @bind-Value="model.Quantity" Label="Cantidad" Min="0.001M" /></MudItem><MudItem xs="12" md="2"><MudTextField @bind-Value="model.Reference" Label="Referencia" /></MudItem><MudItem xs="12" md="2"><MudTextField @bind-Value="model.Notes" Label="Notas" /></MudItem></MudGrid>
<MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Registrar movimiento</MudButton></EditForm></MudPaper>
<MudPaper Class="pa-5"><table class="data-table"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Anterior</th><th>Nuevo</th><th>Referencia</th></tr></thead><tbody>@foreach(var m in movements){<tr><td>@m.CreatedAt.ToLocalTime().ToString("g")</td><td>@m.ProductName</td><td>@m.MovementType</td><td>@m.Quantity</td><td>@m.PreviousStock</td><td>@m.NewStock</td><td>@m.Reference</td></tr>}</tbody></table></MudPaper>
@code { [CascadingParameter]private Task<AuthenticationState> AuthenticationStateTask{get;set;}=null!;private StockChangeRequest model=new(){MovementType=MovementType.Entry};private IReadOnlyList<ProductDto> products=[];private IReadOnlyList<StockMovementDto> movements=[];protected override async Task OnInitializedAsync(){await Load();}private async Task Load(){products=(await Inventory.GetProductsAsync(null,1,100)).Items;movements=(await Inventory.GetMovementsAsync(null,1,100)).Items;}private async Task Save(){var a=await AuthenticationStateTask;var r=await Inventory.ChangeStockAsync(model,a.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);Snackbar.Add(r.Success?"Movimiento registrado.":r.Error!,r.Success?Severity.Success:Severity.Error);if(r.Success){model=new(){MovementType=MovementType.Entry};await Load();}}}
