@page "/ventas"
@attribute [Authorize]
@inject IInventoryService Inventory
@inject ISnackbar Snackbar
<PageTitle>Ventas</PageTitle><div class="page-heading"><div><span class="eyebrow">PUNTO DE VENTA</span><MudText Typo="Typo.h4">Nueva venta</MudText><p>Armá el pedido, confirmá la operación y generá el comprobante.</p></div></div>
<MudGrid><MudItem xs="12" lg="7"><MudPaper Class="pa-5"><MudText Typo="Typo.h6">Productos</MudText><MudTextField @bind-Value="search" Label="Buscar" Immediate="true" />
<table class="data-table"><thead><tr><th>Producto</th><th>Stock</th><th>Precio</th><th></th></tr></thead><tbody>@foreach(var p in filtered){<tr><td>@p.Name</td><td>@p.Stock @p.Unit</td><td>@p.Price.ToString("C")</td><td><MudButton Size="Size.Small" OnClick="@(()=>Add(p))" Disabled="@(p.Stock<=0)">Agregar</MudButton></td></tr>}</tbody></table></MudPaper></MudItem>
<MudItem xs="12" lg="5"><MudPaper Class="pa-5"><MudText Typo="Typo.h6">Carrito</MudText><MudTextField @bind-Value="request.CustomerName" Label="Cliente (opcional)" />
@foreach(var line in cart){<div class="cart-line"><span>@line.Product.Name</span><MudNumericField @bind-Value="line.Quantity" Min="1" Max="line.Product.Stock" Immediate="true" /><strong>@((line.Quantity*line.Product.Price).ToString("C"))</strong><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(()=>cart.Remove(line))" /></div>}
<MudDivider Class="my-4"/><MudText Typo="Typo.h5">Total: @cart.Sum(x=>x.Quantity*x.Product.Price).ToString("C")</MudText><MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4" OnClick="Complete" Disabled="@(cart.Count==0)">Confirmar venta</MudButton>
@if(lastSale is not null){<MudAlert Severity="Severity.Success" Class="mt-4">Venta @lastSale.SaleNumber registrada. <a href="@($"api/sales/{lastSale.Id}/receipt.pdf")" target="_blank">Descargar comprobante PDF</a></MudAlert>}</MudPaper></MudItem></MudGrid>
<MudText Typo="Typo.h5" Class="mt-6">Ventas recientes</MudText><MudPaper Class="pa-5"><table class="data-table"><thead><tr><th>Fecha</th><th>Número</th><th>Cliente</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var s in sales){<tr><td>@s.SaleDate.ToLocalTime().ToString("g")</td><td>@s.SaleNumber</td><td>@s.CustomerName</td><td>@s.TotalAmount.ToString("C")</td><td><a href="@($"api/sales/{s.Id}/receipt.pdf")" target="_blank">PDF</a></td></tr>}</tbody></table></MudPaper>
@code { [CascadingParameter]private Task<AuthenticationState> AuthenticationStateTask{get;set;}=null!;private List<ProductDto> all=[];private IEnumerable<ProductDto> filtered=>all.Where(x=>string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Code.Contains(search,StringComparison.OrdinalIgnoreCase));private List<CartLine> cart=[];private IReadOnlyList<SaleDto> sales=[];private CreateSaleRequest request=new();private SaleDto? lastSale;private string? search;protected override async Task OnInitializedAsync(){all=(await Inventory.GetProductsAsync(null,1,100)).Items.ToList();sales=(await Inventory.GetSalesAsync(null,null,1,20)).Items;}private void Add(ProductDto p){var line=cart.FirstOrDefault(x=>x.Product.Id==p.Id);if(line is null)cart.Add(new(p,1));else if(line.Quantity<p.Stock)line.Quantity++;}private async Task Complete(){request.Items=cart.Select(x=>new SaleItemRequest{ProductId=x.Product.Id,Quantity=x.Quantity}).ToList();var a=await AuthenticationStateTask;var r=await Inventory.CreateSaleAsync(request,a.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);if(!r.Success){Snackbar.Add(r.Error!,Severity.Error);return;}lastSale=r.Value;Snackbar.Add("Venta registrada.",Severity.Success);cart=[];request=new();await OnInitializedAsync();}private sealed class CartLine(ProductDto product,decimal quantity){public ProductDto Product{get;}=product;public decimal Quantity{get;set;}=quantity;}}
