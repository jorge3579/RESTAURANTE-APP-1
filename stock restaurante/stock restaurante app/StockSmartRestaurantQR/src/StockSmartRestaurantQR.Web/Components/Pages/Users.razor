@page "/usuarios"
@attribute [Authorize(Roles="Admin")]
@inject IUserService UserService
@inject ISnackbar Snackbar
<PageTitle>Usuarios</PageTitle><div class="page-heading"><div><span class="eyebrow">SEGURIDAD</span><MudText Typo="Typo.h4">Usuarios y permisos</MudText><p>Administrá el acceso del equipo y sus responsabilidades.</p></div></div>
<MudPaper Class="pa-5 mb-5"><MudText Typo="Typo.h6">Crear empleado</MudText><EditForm Model="model" OnValidSubmit="Save"><MudGrid><MudItem xs="12" md="2"><MudTextField @bind-Value="model.Username" Label="Usuario" Required="true" /></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="model.FullName" Label="Nombre completo" Required="true" /></MudItem><MudItem xs="12" md="3"><MudTextField @bind-Value="model.Email" Label="Email" /></MudItem><MudItem xs="12" md="2"><MudTextField @bind-Value="model.Password" Label="Contraseña inicial" InputType="InputType.Password" Required="true" /></MudItem><MudItem xs="12" md="2"><MudSelect T="string" @bind-Value="model.Role" Label="Rol"><MudSelectItem Value="@("Employee")">Empleado</MudSelectItem><MudSelectItem Value="@("Admin")">Administrador</MudSelectItem></MudSelect></MudItem></MudGrid><MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Crear usuario</MudButton></EditForm></MudPaper>
<MudPaper Class="pa-5"><table class="data-table"><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Último acceso</th><th></th></tr></thead><tbody>@foreach(var u in items){<tr><td>@u.Username</td><td>@u.FullName</td><td>@u.Role</td><td>@(u.IsActive?"Activo":"Inactivo")</td><td>@u.LastLogin?.ToLocalTime().ToString("g")</td><td><MudSwitch T="bool" Value="u.IsActive" ValueChanged="@(v=>Toggle(u.Id,v))" Color="Color.Primary" /></td></tr>}</tbody></table></MudPaper>
@code { private CreateUserRequest model=new();private IReadOnlyList<UserDto> items=[];protected override async Task OnInitializedAsync()=>items=await UserService.GetAllAsync();private async Task Save(){var r=await UserService.CreateAsync(model);Snackbar.Add(r.Success?"Usuario creado.":r.Error!,r.Success?Severity.Success:Severity.Error);if(r.Success){model=new();items=await UserService.GetAllAsync();}}private async Task Toggle(string id,bool active){var r=await UserService.SetActiveAsync(id,active);Snackbar.Add(r.Success?"Estado actualizado.":r.Error!,r.Success?Severity.Success:Severity.Error);items=await UserService.GetAllAsync();}}
